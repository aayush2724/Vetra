# Copy to .env to override the defaults in docker-compose.yml.

# Shared secret the gateway presents when syncing. Empty = accept any gateway.
VETRA_API_KEY=

# Herd streamed by `make docker-demo` (SPEED = simulated minutes per real second).
ANIMALS=12
DAYS=3
SPEED=40000
# Seconds between the gateway's upload attempts.
SYNC_INTERVAL=5

# Training set built by `make docker-train`.
TRAIN_ANIMALS=240
TRAIN_DAYS=5

# Host ports.
CLOUD_PORT=4000
GATEWAY_PORT=5001
MQTT_PORT=1883

# The trainer writes ./data and ./artifacts as this user so the files stay yours.
VETRA_UID=1000
VETRA_GID=1000
